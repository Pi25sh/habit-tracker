# Copy to .env and fill in. NEVER commit the real .env.

# --- app ---
ENVIRONMENT=development
DEBUG=true
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# --- security (generate: openssl rand -hex 64) ---
SECRET_KEY=change-me
# generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOCATION_ENCRYPTION_KEY=change-me

# --- database ---
POSTGRES_USER=habit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=habitdb
DATABASE_URL=postgresql+asyncpg://habit:change-me@postgres:5432/habitdb

# --- redis ---
REDIS_URL=redis://redis:6379/0

# --- minio ---
S3_ACCESS_KEY=habit-minio
S3_SECRET_KEY=change-me
S3_PUBLIC_ENDPOINT=http://localhost:9000

# --- email ---
SMTP_HOST=mailhog
SMTP_PORT=1025
EMAIL_FROM=noreply@habittracker.app

# --- google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- monitoring ---
GRAFANA_PASSWORD=change-me
